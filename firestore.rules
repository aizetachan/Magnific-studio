rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Share invitations: sender manages them; the invitee (by email) can read
    // and accept. Never contains content — just project name + room id.
    match /invites/{inviteId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == request.auth.token.email;
      allow read, delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toEmail == request.auth.token.email.lower());
      allow update: if request.auth != null
        && resource.data.toEmail == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted']);
    }
    // Share links: resolvable by any signed-in user (capability token); only
    // the owner manages them. In approval mode the doc carries NO room key.
    match /links/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Join requests ("knocks"): created by the requester (pending, no room
    // key); only the owner can change status — approval writes the room key.
    match /knocks/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && !("roomId" in request.resource.data);
      // get: resource == null covers probing your own not-yet-created knock
      // (doc ids embed the unguessable link token, so this leaks nothing).
      allow get: if request.auth != null
        && (resource == null
            || resource.data.uid == request.auth.uid
            || resource.data.ownerUid == request.auth.uid);
      allow list: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
