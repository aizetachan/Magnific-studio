rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Share invitations: sender manages them; the invitee (by email) can read
    // and accept. Never contains content — just project name + room id.
    match /invites/{inviteId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == request.auth.token.email;
      allow read, delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toEmail == request.auth.token.email.lower());
      allow update: if request.auth != null
        && resource.data.toEmail == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted']);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
