# Magnific Studio — environment configuration.
# Copy to `.env.local` (git-ignored) to auto-load these on `npm run dev`.
# Everything here is OPTIONAL: with no .env the app runs fully (Claude via the
# dev proxy once you paste a key in Settings; generation simulated).
#
# NOTE: VITE_* vars are bundled into the client. Fine for local dev; in
# production serve secrets from a backend, not the bundle.

# --- Claude (Anthropic) ---
# Optional default key so you don't paste it into Settings each session.
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# Default director model (claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5).
# VITE_DIRECTOR_MODEL=claude-opus-4-8
# Override the API base. Default "/api/anthropic" (dev proxy -> api.anthropic.com).
# Set to the public API to call directly (sends the direct-browser-access header):
# VITE_ANTHROPIC_BASE=https://api.anthropic.com

# --- Magnific (generation) ---
# Turn on REAL generation calls (default off = simulated jobs). When on, the
# Director executes generation by calling the Magnific MCP tools directly with
# each user's OAuth token (see backend env below) — async with live progress.
# VITE_MAGNIFIC_LIVE=true
#
# LEGACY — the REST Business API (api.magnific.ai) is deprecated: Magnific's API
# pay-per-use plan is discontinued on 2026-06-30. Prefer the per-user MCP/OAuth
# path. These remain only for the optional ApiTransport fallback:
# VITE_MAGNIFIC_API_KEY=mag-...
# VITE_MAGNIFIC_API_CONNECTED=true
# VITE_MAGNIFIC_API_TARGET=https://api.magnific.ai
# VITE_MAGNIFIC_GENERATE_PATH=/v1/generations
# MCP endpoint (proxy "/api/mcp" forwards here).
# VITE_MAGNIFIC_MCP_TARGET=https://mcp.magnific.com

# --- Director backend (Claude orchestrates the Magnific MCP, server-side) ---
# The dev proxy forwards "/api/director" to this target. Run it: `npm run server`.
# VITE_DIRECTOR_TARGET=http://localhost:8787

# === Backend process env (read by `npm run server`, NOT VITE_-prefixed) ===
# Set these in the shell that runs the server (or a separate env file):
#   MAGNIFIC_MCP_URL=https://mcp.magnific.com   # REQUIRED for real generation
#                                               # (enables per-user OAuth + MCP)
#   APP_ORIGIN=http://localhost:5173    # where the browser runs (for the OAuth redirect_uri)
#   PORT=8787
#   ANTHROPIC_API_KEY=sk-ant-...        # optional: only for the chat Director;
#   ANTHROPIC_MODEL=claude-opus-4-8     # generation no longer needs it.
#
#   # Per-user OAuth (each user connects their own Magnific account):
#   # By default the backend auto-discovers endpoints and dynamically registers
#   # a client (DCR). Override only if your provider needs it:
#   #   MAGNIFIC_OAUTH_CLIENT_ID=...
#   #   MAGNIFIC_OAUTH_CLIENT_SECRET=...
#   #   MAGNIFIC_OAUTH_AUTH_URL=...        MAGNIFIC_OAUTH_TOKEN_URL=...
#   #   MAGNIFIC_OAUTH_REGISTRATION_URL=...  MAGNIFIC_OAUTH_SCOPE="..."
#   # Or skip OAuth entirely with a static token (single shared account):
#   #   MAGNIFIC_MCP_TOKEN=...

# --- Fase 0: despliegue multi-usuario (opcionales; sin ellas = modo dev local) ---
# Login con Google (Firebase Auth). Frontend (build):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# Backend (Cloud Run):
# FIREBASE_PROJECT_ID=            # habilita la verificación del login
# SESSION_ENC_KEY=                # openssl rand -hex 32 — cifra tokens Magnific en reposo
# DIST_DIR=./dist                 # SPA construida que sirve el server en prod
# Fase 0.5 (Share realtime): además de las anteriores
# VITE_FIREBASE_DATABASE_URL=https://<proj>-default-rtdb.europe-west1.firebasedatabase.app
